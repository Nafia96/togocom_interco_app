    <table>
        <thead>
            <tr>
                <th>Période</th>
                <th>Volume (min)</th>
                <th>PU</th>
                <th>Montant HT</th>
                <th>Montant TTC</th>
            </tr>
        </thead>
        <tbody>
                        <tr>
                <td>2025-10</td>
                <td>130 774,00</td>
                <td>1.2</td>
                <td>156 928,80</td>
                <td>185 175,98</td>
            </tr>
                        <tr>
                <td>2025-11</td>
                <td>122 297,00</td>
                <td>1.2</td>
